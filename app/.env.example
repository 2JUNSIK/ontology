# 이 파일을 복사해 .env 를 만들고 값을 채운다:  cp .env.example .env  (PowerShell: Copy-Item .env.example .env)
# .env 는 gitignore 됨. 실제 비밀키는 .env 에만 둔다.

# --- Anthropic (백엔드에서만 사용, 프론트 노출 금지 / M3에서 필요) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8

# --- Neo4j (docker-compose 와 백엔드가 공용으로 사용) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontology_dev_pw
